# ===== 数据库 / Redis =====
DATABASE_URL=mysql://root:changan2026@mysql:3306/chang_an
REDIS_URL=redis://redis:6379

# ===== 安全 =====
# 部署前必须改为强随机值；上线后不可再改（改了旧推广链失效）
JWT_SECRET=change-me-to-a-long-random-string
# 自定义 Hashids 盐；若要承接旧站存量推广链接，部署时设为 test
HASHIDS_SALT=change-me-to-a-long-random-string
HASHIDS_MIN_LENGTH=4

# ===== 设备拦截 =====
DEVICE_BLOCK_PC=true
DEVICE_ALLOW_TABLET=true

# ===== 业务 =====
# 单片有效期天数（还原原版=1；可设 7/30/0=永久）
SINGLE_EXPIRE_DAYS=1
# 多级分销层级上限
MAX_LEVEL=3
MULTI_LEVEL_COMMISSION=true

# ===== 支付占位 =====
PAY_MOCK_ENABLED=true

# ===== 部署 =====
HOST=0.0.0.0
PORT=3000
